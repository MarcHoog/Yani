# Copy to .env next to compose.yaml. Values from the yani API app registration in the dev tenant.
# Audience of access tokens for the yani API (Application ID URI or client ID).
AUTH_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# Tenant ID of the operator's own Entra tenant.
AUTH_OPERATOR_TENANT_ID=00000000-0000-0000-0000-000000000000
# Comma-separated object IDs (oid) of operator accounts in that tenant.
AUTH_OPERATOR_OBJECT_IDS=00000000-0000-0000-0000-000000000000
