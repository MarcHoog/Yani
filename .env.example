# Copy to .env next to compose.yaml, or let `python dev.py seed` create it.
# ID of the `yani` project in Zitadel (the token audience). `python dev.py seed` writes it.
AUTH_AUDIENCE=
# ID of the operator organization in Zitadel. `python dev.py seed` writes it.
AUTH_OPERATOR_ORG=
# Client ID of the `portal` OIDC app in Zitadel. `python dev.py seed` writes it.
PORTAL_CLIENT_ID=
# Optional overrides of the dev defaults in compose.yaml.
# ZITADEL_MASTERKEY=exactly-32-characters-long-key!!
# ZITADEL_ADMIN_PASSWORD=Yani-dev-admin-1!
# YANI_SEED_PASSWORD=Yani-dev-pass-1!
